{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git status *": "allow",
      "git branch *": "allow",
      "git checkout *": "allow",
      "git stash *": "allow",
      "curl *": "ask",
      "wget *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "rm -rf *": "deny"
    },
    "read": {
      "*": "allow"
    },
    "edit": {
      "*": "allow"
    }
  },
  "mcp": {
    "linear-mcp-server": {
      "type": "local",
      "command": ["npx", "-y", "mcp-remote", "https://mcp.linear.app/mcp"],
      "enabled": true
    }
  }
}
