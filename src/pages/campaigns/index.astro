---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { CAMPAIGN_STATUS_CLASS, CAMPAIGN_STATUS_LABEL } from "@/lib/campaigns/lifecycle";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;

interface CampaignRow {
  id: string;
  title: string;
  goal: string | null;
  status: "draft" | "active" | "completed" | "archived";
  updated_at: string;
  created_at: string;
}

let campaigns: CampaignRow[] = [];
const docCounts = new Map<string, { source: number; insight: number }>();

if (supabase && user) {
  const { data: campaignRows } = await supabase
    .from("campaigns")
    .select("id, title, goal, status, updated_at, created_at")
    .eq("user_id", user.id)
    .order("updated_at", { ascending: false });

  campaigns = campaignRows ?? [];

  if (campaigns.length > 0) {
    const campaignIds = campaigns.map((c) => c.id);
    const { data: docs } = await supabase.from("documents").select("campaign_id, type").in("campaign_id", campaignIds);

    for (const doc of docs ?? []) {
      const existing = docCounts.get(doc.campaign_id) ?? { source: 0, insight: 0 };
      if (doc.type === "source_document") {
        existing.source++;
      } else {
        existing.insight++;
      }
      docCounts.set(doc.campaign_id, existing);
    }
  }
}

const statusLabel = CAMPAIGN_STATUS_LABEL;
const statusClass = CAMPAIGN_STATUS_CLASS;
---

<Layout title="Campaigns">
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-4xl">
      <div class="mb-8 flex items-center justify-between">
        <div>
          <h1 class="text-gradient text-3xl font-bold">Campaigns</h1>
          <p class="text-muted-foreground mt-1 text-sm">Manage your content campaigns and source materials.</p>
        </div>
        <a
          href="/campaigns/new"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors"
        >
          + New Campaign
        </a>
      </div>

      {
        campaigns.length === 0 ? (
          <div class="glass-card flex flex-col items-center justify-center rounded-2xl py-24 text-center">
            <div class="mb-4 text-5xl">🗂️</div>
            <h2 class="text-foreground mb-2 text-xl font-semibold">No campaigns yet</h2>
            <p class="text-muted-foreground mb-8 max-w-sm text-sm">
              Create your first campaign to start organising source documents and generating content ideas.
            </p>
            <a
              href="/campaigns/new"
              class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center gap-2 rounded-lg px-6 py-3 text-sm font-medium transition-colors"
            >
              Create your first campaign
            </a>
          </div>
        ) : (
          <div class="grid gap-4">
            {campaigns.map((campaign) => {
              const counts = docCounts.get(campaign.id) ?? { source: 0, insight: 0 };
              const badge = statusClass[campaign.status];
              const goalSnippet =
                campaign.goal != null ? campaign.goal.slice(0, 100) + (campaign.goal.length > 100 ? "…" : "") : null;
              return (
                <a
                  href={`/campaigns/${campaign.id}`}
                  class="glass-card hover:border-border/50 hover:bg-card/70 block p-6 transition-colors"
                >
                  <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0 flex-1">
                      <h2 class="text-foreground truncate text-lg font-semibold">{campaign.title}</h2>
                      {goalSnippet && <p class="text-muted-foreground mt-1 text-sm">{goalSnippet}</p>}
                    </div>
                    <span class:list={["shrink-0 rounded-full border px-2.5 py-0.5 text-xs font-medium", badge]}>
                      {statusLabel[campaign.status]}
                    </span>
                  </div>
                  <div class="text-muted-foreground/60 mt-4 flex items-center gap-4 text-xs">
                    <span>
                      {counts.source} source doc{counts.source !== 1 ? "s" : ""}
                    </span>
                    <span>·</span>
                    <span>
                      {counts.insight} insight{counts.insight !== 1 ? "s" : ""}
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        )
      }
    </div>
  </div>
</Layout>
