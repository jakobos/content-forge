---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;

interface CampaignRow {
  id: string;
  title: string;
  goal: string | null;
  status: "draft" | "active" | "completed" | "archived";
  updated_at: string;
  created_at: string;
}

let campaigns: CampaignRow[] = [];
const docCounts = new Map<string, { source: number; insight: number }>();

if (supabase && user) {
  const { data: campaignRows } = await supabase
    .from("campaigns")
    .select("id, title, goal, status, updated_at, created_at")
    .eq("user_id", user.id)
    .order("updated_at", { ascending: false });

  campaigns = campaignRows ?? [];

  if (campaigns.length > 0) {
    const campaignIds = campaigns.map((c) => c.id);
    const { data: docs } = await supabase.from("documents").select("campaign_id, type").in("campaign_id", campaignIds);

    for (const doc of docs ?? []) {
      const existing = docCounts.get(doc.campaign_id) ?? { source: 0, insight: 0 };
      if (doc.type === "source_document") {
        existing.source++;
      } else {
        existing.insight++;
      }
      docCounts.set(doc.campaign_id, existing);
    }
  }
}

const statusLabel: Record<string, string> = {
  draft: "Draft",
  active: "Active",
  completed: "Completed",
  archived: "Archived",
};

const statusClass: Record<string, string> = {
  draft: "bg-slate-500/30 text-slate-300 border-slate-500/40",
  active: "bg-green-500/20 text-green-300 border-green-500/40",
  completed: "bg-purple-500/20 text-purple-300 border-purple-500/40",
  archived: "bg-gray-500/20 text-gray-400 border-gray-500/40",
};
---

<Layout title="Campaigns">
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-4xl">
      <div class="mb-8 flex items-center justify-between">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            Campaigns
          </h1>
          <p class="mt-1 text-sm text-blue-100/50">Manage your content campaigns and source materials.</p>
        </div>
        <a
          href="/campaigns/new"
          class="inline-flex items-center gap-2 rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
        >
          + New Campaign
        </a>
      </div>

      {
        campaigns.length === 0 ? (
          <div class="flex flex-col items-center justify-center rounded-2xl border border-white/10 bg-white/5 py-24 text-center backdrop-blur-xl">
            <div class="mb-4 text-5xl">🗂️</div>
            <h2 class="mb-2 text-xl font-semibold text-white">No campaigns yet</h2>
            <p class="mb-8 max-w-sm text-sm text-blue-100/60">
              Create your first campaign to start organising source documents and generating content ideas.
            </p>
            <a
              href="/campaigns/new"
              class="inline-flex items-center gap-2 rounded-lg bg-purple-600 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-purple-500"
            >
              Create your first campaign
            </a>
          </div>
        ) : (
          <div class="grid gap-4">
            {campaigns.map((campaign) => {
              const counts = docCounts.get(campaign.id) ?? { source: 0, insight: 0 };
              const badge = statusClass[campaign.status] ?? statusClass.draft;
              const goalSnippet =
                campaign.goal != null ? campaign.goal.slice(0, 100) + (campaign.goal.length > 100 ? "…" : "") : null;
              return (
                <a
                  href={`/campaigns/${campaign.id}`}
                  class="block rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl transition-colors hover:border-white/20 hover:bg-white/10"
                >
                  <div class="flex items-start justify-between gap-4">
                    <div class="min-w-0 flex-1">
                      <h2 class="truncate text-lg font-semibold text-white">{campaign.title}</h2>
                      {goalSnippet && <p class="mt-1 text-sm text-blue-100/60">{goalSnippet}</p>}
                    </div>
                    <span class:list={["shrink-0 rounded-full border px-2.5 py-0.5 text-xs font-medium", badge]}>
                      {statusLabel[campaign.status] ?? campaign.status}
                    </span>
                  </div>
                  <div class="mt-4 flex items-center gap-4 text-xs text-blue-100/40">
                    <span>
                      {counts.source} source doc{counts.source !== 1 ? "s" : ""}
                    </span>
                    <span>·</span>
                    <span>
                      {counts.insight} insight{counts.insight !== 1 ? "s" : ""}
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        )
      }
    </div>
  </div>
</Layout>
