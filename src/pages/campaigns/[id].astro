---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { CAMPAIGN_STATUS_CLASS, CAMPAIGN_STATUS_LABEL } from "@/lib/campaigns/lifecycle";
import AddSourceDocumentForm from "@/components/campaigns/AddSourceDocumentForm";
import AddInsightForm from "@/components/campaigns/AddInsightForm";
import GenerateIdeasPanel from "@/components/campaigns/GenerateIdeasPanel";
import IdeaActions from "@/components/campaigns/IdeaActions";
import IdeaPublication from "@/components/campaigns/IdeaPublication";
import RegenerateForm from "@/components/campaigns/RegenerateForm";
import type { PublicationRow } from "@/lib/ideas/publication";

const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;

if (!supabase || !user || !id) {
  return Astro.redirect("/campaigns");
}

const { data: campaign } = await supabase
  .from("campaigns")
  .select("id, title, goal, description, status, created_at, updated_at")
  .eq("id", id)
  .eq("user_id", user.id)
  .single();

if (!campaign) {
  return Astro.redirect("/campaigns");
}

const { data: documents } = await supabase
  .from("documents")
  .select("id, title, content, type, source_url, created_at")
  .eq("campaign_id", id)
  .order("created_at", { ascending: false });

const sourceDocs = (documents ?? []).filter((d) => d.type === "source_document");
const insights = (documents ?? []).filter((d) => d.type === "user_insight");

// Query ideas ordered by generation_number desc (newest first), then created_at asc within each batch
const { data: ideasRaw } = await supabase
  .from("ideas")
  .select(
    "id, working_title, hook, key_points, key_quotes, proposed_flow, insights_conclusions, call_to_action, storytelling_angle, target_audience_note, content_format_suggestion, generation_number, status, source, original_description, improvement_hint, created_at",
  )
  .eq("campaign_id", id)
  .order("generation_number", { ascending: false })
  .order("created_at", { ascending: true });

const ideas = ideasRaw ?? [];

// Batch-query fragment references joined to document titles
const ideaIds = ideas.map((i) => i.id);
interface FragRef {
  idea_id: string;
  quote_snippet: string | null;
  document_versions: { documents: { title: string } } | null;
}
let fragRefsByIdeaId = new Map<string, FragRef[]>();

if (ideaIds.length > 0) {
  const { data: fragRefs } = await supabase
    .from("idea_fragment_references")
    .select("idea_id, quote_snippet, document_versions!inner(documents!inner(title))")
    .in("idea_id", ideaIds);

  for (const ref of fragRefs ?? []) {
    const typed = ref as unknown as FragRef;
    const bucket = fragRefsByIdeaId.get(typed.idea_id) ?? [];
    bucket.push(typed);
    fragRefsByIdeaId.set(typed.idea_id, bucket);
  }
}

// Batch-query publication rows for all ideas on this page
let publicationsByIdeaId = new Map<string, PublicationRow>();

if (ideaIds.length > 0) {
  const { data: pubRows } = await supabase
    .from("publications")
    .select("id, idea_id, url, platform_name, published_at, note, created_at")
    .in("idea_id", ideaIds);

  for (const row of pubRows ?? []) {
    publicationsByIdeaId.set(row.idea_id, row);
  }
}

// Group ideas by generation_number (descending — newest first)
type IdeaRow = (typeof ideas)[0];
const generationGroups: { generationNumber: number; ideas: IdeaRow[] }[] = [];
for (const idea of ideas) {
  const last = generationGroups.at(-1);
  if (last?.generationNumber === idea.generation_number) {
    last.ideas.push(idea);
  } else {
    generationGroups.push({ generationNumber: idea.generation_number, ideas: [idea] });
  }
}

const hasDocuments = sourceDocs.length > 0 || insights.length > 0;

const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");

const statusLabel = CAMPAIGN_STATUS_LABEL;
const statusClass = CAMPAIGN_STATUS_CLASS;

const badge = statusClass[campaign.status];
---

<Layout title={campaign.title}>
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-4xl">
      <!-- Back link -->
      <a href="/campaigns" class="text-primary hover:text-primary/80 mb-6 inline-block text-sm transition-colors">
        &larr; All campaigns
      </a>

      <!-- Campaign header -->
      <div class="glass-card mb-8 rounded-2xl p-6">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0 flex-1">
            <h1 class="text-foreground text-2xl font-bold">{campaign.title}</h1>
            {campaign.goal && <p class="text-muted-foreground mt-2">{campaign.goal}</p>}
            {campaign.description && <p class="text-muted-foreground/70 mt-3 text-sm">{campaign.description}</p>}
          </div>
          <span class:list={["shrink-0 rounded-full border px-2.5 py-0.5 text-xs font-medium", badge]}>
            {statusLabel[campaign.status]}
          </span>
        </div>

        <!-- Generate Ideas panel -->
        <div class="border-border mt-5 border-t pt-4">
          <GenerateIdeasPanel campaignId={id} hasDocuments={hasDocuments} client:load />
        </div>
      </div>

      <!-- Feedback banners -->
      {
        success === "document_added" && (
          <div class="border-primary/30 bg-primary/10 text-primary mb-6 rounded-lg border px-4 py-3 text-sm">
            Document added successfully.
          </div>
        )
      }
      {
        error && (
          <div class="border-destructive/30 bg-destructive/10 text-destructive mb-6 rounded-lg border px-4 py-3 text-sm">
            {error}
          </div>
        )
      }

      <!-- Ideas section (server-rendered, above Source Documents) -->
      <section class="mb-10">
        <div class="mb-4 flex items-center gap-2">
          <h2 class="text-foreground text-lg font-semibold">Ideas</h2>
          {
            ideas.length > 0 && (
              <span class="bg-primary/20 text-primary rounded-full px-2 py-0.5 text-xs font-medium">
                {ideas.length}
              </span>
            )
          }
        </div>

        {
          ideas.length === 0 ? (
            <p class="border-border bg-card/50 text-muted-foreground rounded-xl border px-4 py-8 text-center text-sm">
              No ideas yet. Generate ideas from your documents or describe your own above.
            </p>
          ) : (
            <div class="grid gap-6">
              {generationGroups.map((group) => (
                <div>
                  <div class="mb-3 flex items-center gap-3">
                    <h3 class="text-muted-foreground/60 text-sm font-medium">Generation #{group.generationNumber}</h3>
                    <RegenerateForm
                      campaignId={id}
                      generationNumber={group.generationNumber}
                      label="Regenerate batch"
                      client:visible
                    />
                  </div>
                  <div class="grid gap-3">
                    {group.ideas.map((idea) => {
                      const refs = fragRefsByIdeaId.get(idea.id) ?? [];
                      return (
                        <details class="glass-card">
                          <summary class="hover:bg-card/30 cursor-pointer px-4 py-3 select-none">
                            <div class="flex items-start justify-between gap-2">
                              <div class="min-w-0 flex-1">
                                <span class="text-foreground font-medium">{idea.working_title}</span>
                                {idea.source === "manual" && (
                                  <span class="bg-accent/20 text-accent ml-2 rounded-full px-2 py-0.5 text-xs font-medium">
                                    Manual
                                  </span>
                                )}
                                {idea.hook && <p class="text-muted-foreground mt-1 truncate text-sm">{idea.hook}</p>}
                              </div>
                              <IdeaActions
                                ideaId={idea.id}
                                initialStatus={idea.status}
                                idea={idea}
                                refs={refs.map((r) => ({
                                  documentTitle: r.document_versions?.documents.title ?? "Unknown document",
                                  quoteSnippet: r.quote_snippet,
                                }))}
                                client:visible
                              />
                            </div>
                          </summary>

                          <div class="border-border space-y-4 border-t px-4 py-4">
                            {idea.source === "manual" && idea.original_description && (
                              <div>
                                <p class="text-muted-foreground/60 text-xs font-medium tracking-wide uppercase">
                                  Your description
                                </p>
                                <blockquote class="border-primary/40 text-muted-foreground mt-1 border-l-2 pl-3 text-sm italic">
                                  {idea.original_description}
                                </blockquote>
                              </div>
                            )}
                            {idea.improvement_hint && (
                              <div>
                                <p class="text-muted-foreground/60 text-xs font-medium tracking-wide uppercase">
                                  Improvement hint
                                </p>
                                <blockquote class="border-accent/40 text-muted-foreground mt-1 border-l-2 pl-3 text-sm italic">
                                  {idea.improvement_hint}
                                </blockquote>
                              </div>
                            )}
                            {idea.hook && (
                              <div>
                                <p class="text-muted-foreground/60 text-xs font-medium tracking-wide uppercase">Hook</p>
                                <p class="text-muted-foreground mt-1 text-sm">{idea.hook}</p>
                              </div>
                            )}

                            {idea.key_points && idea.key_points.length > 0 && (
                              <div>
                                <p class="text-muted-foreground/60 text-xs font-medium tracking-wide uppercase">
                                  Key Points
                                </p>
                                <ul class="mt-1 list-inside list-disc space-y-1">
                                  {idea.key_points.map((pt) => (
                                    <li class="text-muted-foreground text-sm">{pt}</li>
                                  ))}
                                </ul>
                              </div>
                            )}

                            {idea.key_quotes.length > 0 && (
                              <div>
                                <p class="text-muted-foreground/60 text-xs font-medium tracking-wide uppercase">
                                  Key Quotes
                                </p>
                                <div class="mt-1 space-y-1">
                                  {idea.key_quotes.map((q) => (
                                    <blockquote class="border-ring/40 text-muted-foreground border-l-2 pl-3 text-sm italic">
                                      {q}
                                    </blockquote>
                                  ))}
                                </div>
                              </div>
                            )}

                            {idea.proposed_flow && (
                              <div>
                                <p class="text-muted-foreground/60 text-xs font-medium tracking-wide uppercase">
                                  Proposed Flow
                                </p>
                                <p class="text-muted-foreground mt-1 text-sm">{idea.proposed_flow}</p>
                              </div>
                            )}

                            {idea.insights_conclusions && (
                              <div>
                                <p class="text-muted-foreground/60 text-xs font-medium tracking-wide uppercase">
                                  Insights & Conclusions
                                </p>
                                <p class="text-muted-foreground mt-1 text-sm">{idea.insights_conclusions}</p>
                              </div>
                            )}

                            {idea.call_to_action && (
                              <div>
                                <p class="text-muted-foreground/60 text-xs font-medium tracking-wide uppercase">
                                  Call to Action
                                </p>
                                <p class="text-muted-foreground mt-1 text-sm">{idea.call_to_action}</p>
                              </div>
                            )}

                            {idea.storytelling_angle && (
                              <div>
                                <p class="text-muted-foreground/60 text-xs font-medium tracking-wide uppercase">
                                  Storytelling Angle
                                </p>
                                <p class="text-muted-foreground mt-1 text-sm">{idea.storytelling_angle}</p>
                              </div>
                            )}

                            {idea.target_audience_note && (
                              <div>
                                <p class="text-muted-foreground/60 text-xs font-medium tracking-wide uppercase">
                                  Target Audience
                                </p>
                                <p class="text-muted-foreground mt-1 text-sm">{idea.target_audience_note}</p>
                              </div>
                            )}

                            {idea.content_format_suggestion && (
                              <div>
                                <p class="text-muted-foreground/60 text-xs font-medium tracking-wide uppercase">
                                  Content Format
                                </p>
                                <p class="text-muted-foreground mt-1 text-sm">{idea.content_format_suggestion}</p>
                              </div>
                            )}

                            {refs.length > 0 && (
                              <div>
                                <p class="text-muted-foreground/60 text-xs font-medium tracking-wide uppercase">
                                  Sources
                                </p>
                                <div class="mt-1 space-y-2">
                                  {refs.map((ref) => (
                                    <div class="border-border/30 bg-card/30 rounded-lg border px-3 py-2">
                                      <p class="text-primary text-xs font-medium">
                                        {ref.document_versions?.documents.title ?? "Unknown document"}
                                      </p>
                                      {ref.quote_snippet && (
                                        <p class="text-muted-foreground mt-0.5 text-xs italic">
                                          &ldquo;{ref.quote_snippet}&rdquo;
                                        </p>
                                      )}
                                    </div>
                                  ))}
                                </div>
                              </div>
                            )}

                            <IdeaPublication
                              ideaId={idea.id}
                              status={idea.status}
                              publication={publicationsByIdeaId.get(idea.id) ?? null}
                              client:visible
                            />

                            <RegenerateForm
                              campaignId={id}
                              generationNumber={idea.generation_number}
                              ideaId={idea.id}
                              client:visible
                            />
                          </div>
                        </details>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          )
        }
      </section>

      <!-- Source Documents section -->
      <section class="mb-10">
        <h2 class="text-foreground mb-4 text-lg font-semibold">Source Documents</h2>

        {
          sourceDocs.length === 0 ? (
            <p class="border-border bg-card/50 text-muted-foreground mb-4 rounded-xl border px-4 py-8 text-center text-sm">
              No source documents yet. Add one below.
            </p>
          ) : (
            <div class="mb-6 grid gap-3">
              {sourceDocs.map((doc) => (
                <div class="border-border bg-card/50 rounded-xl border p-4">
                  <div class="flex items-start justify-between gap-2">
                    <h3 class="text-foreground font-medium">{doc.title}</h3>
                    {doc.source_url && (
                      <a
                        href={doc.source_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-primary shrink-0 text-xs hover:underline"
                      >
                        Source ↗
                      </a>
                    )}
                  </div>
                  <p class="text-muted-foreground mt-2 text-sm">
                    {doc.content.slice(0, 200)}
                    {doc.content.length > 200 ? "…" : ""}
                  </p>
                  <p class="text-muted-foreground/40 mt-2 text-xs">
                    Added {new Date(doc.created_at).toLocaleDateString()}
                  </p>
                </div>
              ))}
            </div>
          )
        }

        <details class="glass-card">
          <summary
            class="text-primary hover:text-primary/80 cursor-pointer rounded-xl px-4 py-3 text-sm font-medium select-none"
          >
            + Add source document
          </summary>
          <div class="border-border border-t p-4">
            <AddSourceDocumentForm campaignId={id} client:load />
          </div>
        </details>
      </section>

      <!-- User Insights section -->
      <section>
        <h2 class="text-foreground mb-4 text-lg font-semibold">User Insights</h2>

        {
          insights.length === 0 ? (
            <p class="border-border bg-card/50 text-muted-foreground mb-4 rounded-xl border px-4 py-8 text-center text-sm">
              No user insights yet. Add one below.
            </p>
          ) : (
            <div class="mb-6 grid gap-3">
              {insights.map((doc) => (
                <div class="border-border bg-card/50 rounded-xl border p-4">
                  <h3 class="text-foreground font-medium">{doc.title}</h3>
                  <p class="text-muted-foreground mt-2 text-sm">
                    {doc.content.slice(0, 200)}
                    {doc.content.length > 200 ? "…" : ""}
                  </p>
                  <p class="text-muted-foreground/40 mt-2 text-xs">
                    Added {new Date(doc.created_at).toLocaleDateString()}
                  </p>
                </div>
              ))}
            </div>
          )
        }

        <details class="glass-card">
          <summary
            class="text-primary hover:text-primary/80 cursor-pointer rounded-xl px-4 py-3 text-sm font-medium select-none"
          >
            + Add user insight
          </summary>
          <div class="border-border border-t p-4">
            <AddInsightForm campaignId={id} client:load />
          </div>
        </details>
      </section>
    </div>
  </div>
</Layout>
