---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import AddSourceDocumentForm from "@/components/campaigns/AddSourceDocumentForm";
import AddInsightForm from "@/components/campaigns/AddInsightForm";
import GenerateIdeasPanel from "@/components/campaigns/GenerateIdeasPanel";
import IdeaActions from "@/components/campaigns/IdeaActions";
import IdeaPublication from "@/components/campaigns/IdeaPublication";
import type { PublicationRow } from "@/lib/ideas/publication";

const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;

if (!supabase || !user || !id) {
  return Astro.redirect("/campaigns");
}

const { data: campaign } = await supabase
  .from("campaigns")
  .select("id, title, goal, description, status, created_at, updated_at")
  .eq("id", id)
  .eq("user_id", user.id)
  .single();

if (!campaign) {
  return Astro.redirect("/campaigns");
}

const { data: documents } = await supabase
  .from("documents")
  .select("id, title, content, type, source_url, created_at")
  .eq("campaign_id", id)
  .order("created_at", { ascending: false });

const sourceDocs = (documents ?? []).filter((d) => d.type === "source_document");
const insights = (documents ?? []).filter((d) => d.type === "user_insight");

// Query ideas ordered by generation_number desc (newest first), then created_at asc within each batch
const { data: ideasRaw } = await supabase
  .from("ideas")
  .select(
    "id, working_title, hook, key_points, key_quotes, proposed_flow, insights_conclusions, call_to_action, storytelling_angle, target_audience_note, content_format_suggestion, generation_number, status, created_at",
  )
  .eq("campaign_id", id)
  .order("generation_number", { ascending: false })
  .order("created_at", { ascending: true });

const ideas = ideasRaw ?? [];

// Batch-query fragment references joined to document titles
const ideaIds = ideas.map((i) => i.id);
interface FragRef {
  idea_id: string;
  quote_snippet: string | null;
  document_versions: { documents: { title: string } } | null;
}
let fragRefsByIdeaId = new Map<string, FragRef[]>();

if (ideaIds.length > 0) {
  const { data: fragRefs } = await supabase
    .from("idea_fragment_references")
    .select("idea_id, quote_snippet, document_versions!inner(documents!inner(title))")
    .in("idea_id", ideaIds);

  for (const ref of fragRefs ?? []) {
    const typed = ref as unknown as FragRef;
    const bucket = fragRefsByIdeaId.get(typed.idea_id) ?? [];
    bucket.push(typed);
    fragRefsByIdeaId.set(typed.idea_id, bucket);
  }
}

// Batch-query publication rows for all ideas on this page
let publicationsByIdeaId = new Map<string, PublicationRow>();

if (ideaIds.length > 0) {
  const { data: pubRows } = await supabase
    .from("publications")
    .select("id, idea_id, url, platform_name, published_at, note, created_at")
    .in("idea_id", ideaIds);

  for (const row of pubRows ?? []) {
    publicationsByIdeaId.set(row.idea_id, row);
  }
}

// Group ideas by generation_number (descending — newest first)
type IdeaRow = (typeof ideas)[0];
const generationGroups: { generationNumber: number; ideas: IdeaRow[] }[] = [];
for (const idea of ideas) {
  const last = generationGroups.at(-1);
  if (last?.generationNumber === idea.generation_number) {
    last.ideas.push(idea);
  } else {
    generationGroups.push({ generationNumber: idea.generation_number, ideas: [idea] });
  }
}

const hasDocuments = sourceDocs.length > 0 || insights.length > 0;

const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");

const statusLabel: Record<string, string> = {
  draft: "Draft",
  active: "Active",
  completed: "Completed",
  archived: "Archived",
};

const statusClass: Record<string, string> = {
  draft: "bg-slate-500/30 text-slate-300 border-slate-500/40",
  active: "bg-green-500/20 text-green-300 border-green-500/40",
  completed: "bg-purple-500/20 text-purple-300 border-purple-500/40",
  archived: "bg-gray-500/20 text-gray-400 border-gray-500/40",
};

const badge = statusClass[campaign.status] ?? statusClass.draft;
---

<Layout title={campaign.title}>
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-4xl">
      <!-- Back link -->
      <a href="/campaigns" class="mb-6 inline-block text-sm text-purple-300 transition-colors hover:text-purple-100">
        &larr; All campaigns
      </a>

      <!-- Campaign header -->
      <div class="mb-8 rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0 flex-1">
            <h1 class="text-2xl font-bold text-white">{campaign.title}</h1>
            {campaign.goal && <p class="mt-2 text-blue-100/70">{campaign.goal}</p>}
            {campaign.description && <p class="mt-3 text-sm text-blue-100/50">{campaign.description}</p>}
          </div>
          <span class:list={["shrink-0 rounded-full border px-2.5 py-0.5 text-xs font-medium", badge]}>
            {statusLabel[campaign.status] ?? campaign.status}
          </span>
        </div>

        <!-- Generate Ideas panel -->
        <div class="mt-5 border-t border-white/10 pt-4">
          <GenerateIdeasPanel campaignId={id} hasDocuments={hasDocuments} client:load />
        </div>
      </div>

      <!-- Feedback banners -->
      {
        success === "document_added" && (
          <div class="mb-6 rounded-lg border border-green-500/30 bg-green-900/20 px-4 py-3 text-sm text-green-300">
            Document added successfully.
          </div>
        )
      }
      {
        error && (
          <div class="mb-6 rounded-lg border border-red-500/30 bg-red-900/20 px-4 py-3 text-sm text-red-300">
            {error}
          </div>
        )
      }

      <!-- Ideas section (server-rendered, above Source Documents) -->
      <section class="mb-10">
        <div class="mb-4 flex items-center gap-2">
          <h2 class="text-lg font-semibold text-white">Ideas</h2>
          {
            ideas.length > 0 && (
              <span class="rounded-full bg-purple-500/20 px-2 py-0.5 text-xs font-medium text-purple-300">
                {ideas.length}
              </span>
            )
          }
        </div>

        {
          ideas.length === 0 ? (
            <p class="rounded-xl border border-white/10 bg-white/5 px-4 py-8 text-center text-sm text-blue-100/50">
              No ideas yet. Use Generate Ideas above to create your first batch.
            </p>
          ) : (
            <div class="grid gap-6">
              {generationGroups.map((group) => (
                <div>
                  <h3 class="mb-3 text-sm font-medium text-blue-100/50">Generation #{group.generationNumber}</h3>
                  <div class="grid gap-3">
                    {group.ideas.map((idea) => {
                      const refs = fragRefsByIdeaId.get(idea.id) ?? [];
                      return (
                        <details class="rounded-xl border border-white/10 bg-white/5">
                          <summary class="cursor-pointer px-4 py-3 select-none hover:bg-white/5">
                            <div class="flex items-start justify-between gap-2">
                              <div class="min-w-0 flex-1">
                                <span class="font-medium text-white">{idea.working_title}</span>
                                {idea.hook && <p class="mt-1 truncate text-sm text-blue-100/60">{idea.hook}</p>}
                              </div>
                              <IdeaActions
                                ideaId={idea.id}
                                initialStatus={idea.status}
                                idea={idea}
                                refs={refs.map((r) => ({
                                  documentTitle: r.document_versions?.documents.title ?? "Unknown document",
                                  quoteSnippet: r.quote_snippet,
                                }))}
                                client:visible
                              />
                            </div>
                          </summary>

                          <div class="space-y-4 border-t border-white/10 px-4 py-4">
                            {idea.hook && (
                              <div>
                                <p class="text-xs font-medium tracking-wide text-blue-100/40 uppercase">Hook</p>
                                <p class="mt-1 text-sm text-blue-100/80">{idea.hook}</p>
                              </div>
                            )}

                            {idea.key_points && idea.key_points.length > 0 && (
                              <div>
                                <p class="text-xs font-medium tracking-wide text-blue-100/40 uppercase">Key Points</p>
                                <ul class="mt-1 list-inside list-disc space-y-1">
                                  {idea.key_points.map((pt) => (
                                    <li class="text-sm text-blue-100/70">{pt}</li>
                                  ))}
                                </ul>
                              </div>
                            )}

                            {idea.key_quotes.length > 0 && (
                              <div>
                                <p class="text-xs font-medium tracking-wide text-blue-100/40 uppercase">Key Quotes</p>
                                <div class="mt-1 space-y-1">
                                  {idea.key_quotes.map((q) => (
                                    <blockquote class="border-l-2 border-purple-500/40 pl-3 text-sm text-blue-100/70 italic">
                                      {q}
                                    </blockquote>
                                  ))}
                                </div>
                              </div>
                            )}

                            {idea.proposed_flow && (
                              <div>
                                <p class="text-xs font-medium tracking-wide text-blue-100/40 uppercase">
                                  Proposed Flow
                                </p>
                                <p class="mt-1 text-sm text-blue-100/70">{idea.proposed_flow}</p>
                              </div>
                            )}

                            {idea.insights_conclusions && (
                              <div>
                                <p class="text-xs font-medium tracking-wide text-blue-100/40 uppercase">
                                  Insights & Conclusions
                                </p>
                                <p class="mt-1 text-sm text-blue-100/70">{idea.insights_conclusions}</p>
                              </div>
                            )}

                            {idea.call_to_action && (
                              <div>
                                <p class="text-xs font-medium tracking-wide text-blue-100/40 uppercase">
                                  Call to Action
                                </p>
                                <p class="mt-1 text-sm text-blue-100/70">{idea.call_to_action}</p>
                              </div>
                            )}

                            {idea.storytelling_angle && (
                              <div>
                                <p class="text-xs font-medium tracking-wide text-blue-100/40 uppercase">
                                  Storytelling Angle
                                </p>
                                <p class="mt-1 text-sm text-blue-100/70">{idea.storytelling_angle}</p>
                              </div>
                            )}

                            {idea.target_audience_note && (
                              <div>
                                <p class="text-xs font-medium tracking-wide text-blue-100/40 uppercase">
                                  Target Audience
                                </p>
                                <p class="mt-1 text-sm text-blue-100/70">{idea.target_audience_note}</p>
                              </div>
                            )}

                            {idea.content_format_suggestion && (
                              <div>
                                <p class="text-xs font-medium tracking-wide text-blue-100/40 uppercase">
                                  Content Format
                                </p>
                                <p class="mt-1 text-sm text-blue-100/70">{idea.content_format_suggestion}</p>
                              </div>
                            )}

                            {refs.length > 0 && (
                              <div>
                                <p class="text-xs font-medium tracking-wide text-blue-100/40 uppercase">Sources</p>
                                <div class="mt-1 space-y-2">
                                  {refs.map((ref) => (
                                    <div class="rounded-lg border border-white/5 bg-white/5 px-3 py-2">
                                      <p class="text-xs font-medium text-purple-300">
                                        {ref.document_versions?.documents.title ?? "Unknown document"}
                                      </p>
                                      {ref.quote_snippet && (
                                        <p class="mt-0.5 text-xs text-blue-100/60 italic">
                                          &ldquo;{ref.quote_snippet}&rdquo;
                                        </p>
                                      )}
                                    </div>
                                  ))}
                                </div>
                              </div>
                            )}

                            <IdeaPublication
                              ideaId={idea.id}
                              status={idea.status}
                              publication={publicationsByIdeaId.get(idea.id) ?? null}
                              client:visible
                            />
                          </div>
                        </details>
                      );
                    })}
                  </div>
                </div>
              ))}
            </div>
          )
        }
      </section>

      <!-- Source Documents section -->
      <section class="mb-10">
        <h2 class="mb-4 text-lg font-semibold text-white">Source Documents</h2>

        {
          sourceDocs.length === 0 ? (
            <p class="mb-4 rounded-xl border border-white/10 bg-white/5 px-4 py-8 text-center text-sm text-blue-100/50">
              No source documents yet. Add one below.
            </p>
          ) : (
            <div class="mb-6 grid gap-3">
              {sourceDocs.map((doc) => (
                <div class="rounded-xl border border-white/10 bg-white/5 p-4">
                  <div class="flex items-start justify-between gap-2">
                    <h3 class="font-medium text-white">{doc.title}</h3>
                    {doc.source_url && (
                      <a
                        href={doc.source_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="shrink-0 text-xs text-purple-300 hover:underline"
                      >
                        Source ↗
                      </a>
                    )}
                  </div>
                  <p class="mt-2 text-sm text-blue-100/60">
                    {doc.content.slice(0, 200)}
                    {doc.content.length > 200 ? "…" : ""}
                  </p>
                  <p class="mt-2 text-xs text-blue-100/30">Added {new Date(doc.created_at).toLocaleDateString()}</p>
                </div>
              ))}
            </div>
          )
        }

        <details class="rounded-xl border border-white/10 bg-white/5">
          <summary
            class="cursor-pointer rounded-xl px-4 py-3 text-sm font-medium text-purple-300 select-none hover:text-purple-100"
          >
            + Add source document
          </summary>
          <div class="border-t border-white/10 p-4">
            <AddSourceDocumentForm campaignId={id} client:load />
          </div>
        </details>
      </section>

      <!-- User Insights section -->
      <section>
        <h2 class="mb-4 text-lg font-semibold text-white">User Insights</h2>

        {
          insights.length === 0 ? (
            <p class="mb-4 rounded-xl border border-white/10 bg-white/5 px-4 py-8 text-center text-sm text-blue-100/50">
              No user insights yet. Add one below.
            </p>
          ) : (
            <div class="mb-6 grid gap-3">
              {insights.map((doc) => (
                <div class="rounded-xl border border-white/10 bg-white/5 p-4">
                  <h3 class="font-medium text-white">{doc.title}</h3>
                  <p class="mt-2 text-sm text-blue-100/60">
                    {doc.content.slice(0, 200)}
                    {doc.content.length > 200 ? "…" : ""}
                  </p>
                  <p class="mt-2 text-xs text-blue-100/30">Added {new Date(doc.created_at).toLocaleDateString()}</p>
                </div>
              ))}
            </div>
          )
        }

        <details class="rounded-xl border border-white/10 bg-white/5">
          <summary
            class="cursor-pointer rounded-xl px-4 py-3 text-sm font-medium text-purple-300 select-none hover:text-purple-100"
          >
            + Add user insight
          </summary>
          <div class="border-t border-white/10 p-4">
            <AddInsightForm campaignId={id} client:load />
          </div>
        </details>
      </section>
    </div>
  </div>
</Layout>
