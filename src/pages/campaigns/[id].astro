---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import AddSourceDocumentForm from "@/components/campaigns/AddSourceDocumentForm";
import AddInsightForm from "@/components/campaigns/AddInsightForm";

const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { user } = Astro.locals;

if (!supabase || !user || !id) {
  return Astro.redirect("/campaigns");
}

const { data: campaign } = await supabase
  .from("campaigns")
  .select("id, title, goal, description, status, created_at, updated_at")
  .eq("id", id)
  .eq("user_id", user.id)
  .single();

if (!campaign) {
  return Astro.redirect("/campaigns");
}

const { data: documents } = await supabase
  .from("documents")
  .select("id, title, content, type, source_url, created_at")
  .eq("campaign_id", id)
  .order("created_at", { ascending: false });

const sourceDocs = (documents ?? []).filter((d) => d.type === "source_document");
const insights = (documents ?? []).filter((d) => d.type === "user_insight");

const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");

const statusLabel: Record<string, string> = {
  draft: "Draft",
  active: "Active",
  completed: "Completed",
  archived: "Archived",
};

const statusClass: Record<string, string> = {
  draft: "bg-slate-500/30 text-slate-300 border-slate-500/40",
  active: "bg-green-500/20 text-green-300 border-green-500/40",
  completed: "bg-purple-500/20 text-purple-300 border-purple-500/40",
  archived: "bg-gray-500/20 text-gray-400 border-gray-500/40",
};

const badge = statusClass[campaign.status] ?? statusClass.draft;
---

<Layout title={campaign.title}>
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-4xl">
      <!-- Back link -->
      <a href="/campaigns" class="mb-6 inline-block text-sm text-purple-300 transition-colors hover:text-purple-100">
        &larr; All campaigns
      </a>

      <!-- Campaign header -->
      <div class="mb-8 rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
        <div class="flex items-start justify-between gap-4">
          <div class="min-w-0 flex-1">
            <h1 class="text-2xl font-bold text-white">{campaign.title}</h1>
            {campaign.goal && <p class="mt-2 text-blue-100/70">{campaign.goal}</p>}
            {campaign.description && <p class="mt-3 text-sm text-blue-100/50">{campaign.description}</p>}
          </div>
          <span class:list={["shrink-0 rounded-full border px-2.5 py-0.5 text-xs font-medium", badge]}>
            {statusLabel[campaign.status] ?? campaign.status}
          </span>
        </div>
      </div>

      <!-- Feedback banners -->
      {
        success === "document_added" && (
          <div class="mb-6 rounded-lg border border-green-500/30 bg-green-900/20 px-4 py-3 text-sm text-green-300">
            Document added successfully.
          </div>
        )
      }
      {
        error && (
          <div class="mb-6 rounded-lg border border-red-500/30 bg-red-900/20 px-4 py-3 text-sm text-red-300">
            {error}
          </div>
        )
      }

      <!-- Source Documents section -->
      <section class="mb-10">
        <h2 class="mb-4 text-lg font-semibold text-white">Source Documents</h2>

        {
          sourceDocs.length === 0 ? (
            <p class="mb-4 rounded-xl border border-white/10 bg-white/5 px-4 py-8 text-center text-sm text-blue-100/50">
              No source documents yet. Add one below.
            </p>
          ) : (
            <div class="mb-6 grid gap-3">
              {sourceDocs.map((doc) => (
                <div class="rounded-xl border border-white/10 bg-white/5 p-4">
                  <div class="flex items-start justify-between gap-2">
                    <h3 class="font-medium text-white">{doc.title}</h3>
                    {doc.source_url && (
                      <a
                        href={doc.source_url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="shrink-0 text-xs text-purple-300 hover:underline"
                      >
                        Source ↗
                      </a>
                    )}
                  </div>
                  <p class="mt-2 text-sm text-blue-100/60">
                    {doc.content.slice(0, 200)}
                    {doc.content.length > 200 ? "…" : ""}
                  </p>
                  <p class="mt-2 text-xs text-blue-100/30">Added {new Date(doc.created_at).toLocaleDateString()}</p>
                </div>
              ))}
            </div>
          )
        }

        <details class="rounded-xl border border-white/10 bg-white/5">
          <summary
            class="cursor-pointer rounded-xl px-4 py-3 text-sm font-medium text-purple-300 select-none hover:text-purple-100"
          >
            + Add source document
          </summary>
          <div class="border-t border-white/10 p-4">
            <AddSourceDocumentForm campaignId={id} client:load />
          </div>
        </details>
      </section>

      <!-- User Insights section -->
      <section>
        <h2 class="mb-4 text-lg font-semibold text-white">User Insights</h2>

        {
          insights.length === 0 ? (
            <p class="mb-4 rounded-xl border border-white/10 bg-white/5 px-4 py-8 text-center text-sm text-blue-100/50">
              No user insights yet. Add one below.
            </p>
          ) : (
            <div class="mb-6 grid gap-3">
              {insights.map((doc) => (
                <div class="rounded-xl border border-white/10 bg-white/5 p-4">
                  <h3 class="font-medium text-white">{doc.title}</h3>
                  <p class="mt-2 text-sm text-blue-100/60">
                    {doc.content.slice(0, 200)}
                    {doc.content.length > 200 ? "…" : ""}
                  </p>
                  <p class="mt-2 text-xs text-blue-100/30">Added {new Date(doc.created_at).toLocaleDateString()}</p>
                </div>
              ))}
            </div>
          )
        }

        <details class="rounded-xl border border-white/10 bg-white/5">
          <summary
            class="cursor-pointer rounded-xl px-4 py-3 text-sm font-medium text-purple-300 select-none hover:text-purple-100"
          >
            + Add user insight
          </summary>
          <div class="border-t border-white/10 p-4">
            <AddInsightForm campaignId={id} client:load />
          </div>
        </details>
      </section>
    </div>
  </div>
</Layout>
