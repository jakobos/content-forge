---
import Layout from "@/layouts/Layout.astro";
import CampaignCreateForm from "@/components/campaigns/CampaignCreateForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="New Campaign">
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-xl">
      <div class="mb-8">
        <a href="/campaigns" class="text-sm text-purple-300 transition-colors hover:text-purple-100">
          &larr; Back to campaigns
        </a>
        <h1 class="mt-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          New Campaign
        </h1>
        <p class="mt-1 text-sm text-blue-100/50">Give your campaign a name and a goal to get started.</p>
      </div>

      <div class="rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-xl">
        <CampaignCreateForm serverError={error} client:load />
      </div>
    </div>
  </div>
</Layout>
