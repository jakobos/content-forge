---
import Layout from "@/layouts/Layout.astro";
import CampaignCreateForm from "@/components/campaigns/CampaignCreateForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="New Campaign">
  <div class="min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-xl">
      <div class="mb-8">
        <a href="/campaigns" class="text-primary hover:text-primary/80 text-sm transition-colors">
          &larr; Back to campaigns
        </a>
        <h1 class="text-gradient mt-4 text-3xl font-bold">New Campaign</h1>
        <p class="text-muted-foreground mt-1 text-sm">Give your campaign a name and a goal to get started.</p>
      </div>

      <div class="glass-card rounded-2xl p-8">
        <CampaignCreateForm serverError={error} client:load />
      </div>
    </div>
  </div>
</Layout>
